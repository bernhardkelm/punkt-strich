{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/punkt.sh hook", "async": true }]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/punkt.sh hook", "async": true }]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/punkt.sh hook", "async": true }]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/punkt.sh hook", "async": true }]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/punkt.sh hook", "timeout": 5 }]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/punkt.sh hook", "async": true }]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/punkt.sh hook", "async": true }]
      }
    ],
    "Notification": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/punkt.sh hook", "async": true }]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/punkt.sh hook", "async": true }]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/punkt.sh hook", "async": true }]
      }
    ],
    "PreCompact": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/punkt.sh hook", "async": true }]
      }
    ],
    "PostCompact": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/punkt.sh hook", "async": true }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/punkt.sh hook", "async": true }]
      }
    ],
    "StopFailure": [
      {
        "hooks": [{ "type": "command", "command": "$HOME/.claude/hooks/punkt.sh hook", "async": true }]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/hooks/punkt-statusline.sh"
  }
}
